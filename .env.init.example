# Secrets consumed ONLY by vault-init to seed HashiCorp Vault.
# Copy to .env.init and fill in real values.
#
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Generate KEK:        python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"

SECRET_KEY=dev-secret-change-me
KEK=
