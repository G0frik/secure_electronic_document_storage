# App configuration — non-sensitive defaults only.
# Passwords and secrets live in .env.init (consumed by Vault).

# App
ALLOW_PUBLIC_REGISTRATION=true
HIBP_USER_AGENT=secure-docstore-dev
LOG_LEVEL=INFO

# Database
POSTGRES_USER=docstore
POSTGRES_DB=docstore

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_BUCKET=documents

# Classifier
CLASSIFIER_MODEL=large
CLASSIFIER_MULTILINGUAL=false
# Semantic engine: nli (default) or llm (llama.cpp llama-server on the host, OpenAI-compatible API)
CLASSIFIER_ENGINE=nli
# Prompt-injection defenses, comma-separated subset of D1 (hardened LLM prompt),
# D2 (also classify the visible text, keep the higher tier), D4 (injection detector gate)
CLASSIFIER_DEFENSES=
CLASSIFIER_DETECTOR=pg2
LLM_BASE_URL=http://host.docker.internal:18080
LLM_MODEL=gemma4-12b

# Mail
MAIL_SERVER=mailhog
MAIL_PORT=1025
NOTIFICATIONS_EMAIL_ENABLED=true

# Event log
EVENT_LOG_PATH=/var/log/docstore/events.jsonl

# Vault
VAULT_DEV_ROOT_TOKEN_ID=dev-root-token
VAULT_TOKEN=dev-app-token
KEK_VERSION=1
