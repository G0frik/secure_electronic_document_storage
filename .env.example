# Copy to .env and fill in real values for local dev.
# .env is gitignored.

# --- Postgres ---
POSTGRES_USER=docstore
POSTGRES_PASSWORD=docstore
POSTGRES_DB=docstore

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=documents

# --- App secrets ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-secret-change-me

# Key Encryption Key — 32 random bytes, base64-encoded. Used by Phase 3
# envelope encryption to wrap per-file DEKs.
# Generate with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# If unset in dev, a KEK is derived from SECRET_KEY with a warning. In prod
# you MUST set this explicitly (and never derive).
KEK=XejNP5Q6y1QLDhQtlNxPVWldmpkI3K2MZq4EZGoknCg=

# --- Auth (Phase 1) ---
# Open registration in dev; flip to 'false' in prod (admin-only registration).
ALLOW_PUBLIC_REGISTRATION=true
# HaveIBeenPwned API requires a descriptive User-Agent identifying your app.
HIBP_USER_AGENT=secure-docstore-dev

# --- Logging ---
LOG_LEVEL=INFO
