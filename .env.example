# App configuration — non-sensitive defaults only.
# Passwords and secrets live in .env.init (consumed by Vault).

# App
ALLOW_PUBLIC_REGISTRATION=true
HIBP_USER_AGENT=secure-docstore-dev
LOG_LEVEL=INFO

# Database
POSTGRES_USER=docstore
POSTGRES_DB=docstore

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_BUCKET=documents

# Classifier
CLASSIFIER_MODEL=large
CLASSIFIER_MULTILINGUAL=false

# Mail
MAIL_SERVER=mailhog
MAIL_PORT=1025
NOTIFICATIONS_EMAIL_ENABLED=true

# Event log
EVENT_LOG_PATH=/var/log/docstore/events.jsonl

# Vault
VAULT_DEV_ROOT_TOKEN_ID=dev-root-token
VAULT_TOKEN=dev-app-token
KEK_VERSION=1
